rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ PUT YOUR OWN EMAIL HERE — the account the Mac panel signs in with.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'teseomorete@gmail.com';
    }

    // Each user owns their library. The admin can read (not write) for stats.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Anonymous usage pings — a device writes only its own row.
    match /usage/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Feedback: anyone signed in can send; only the admin reads it.
    match /feedback/{doc} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Update notice: everyone reads it, only the admin publishes it.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
